{
  "name": "architecture-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "build:netlify": "ng build --configuration production,netlify",
    "test:netlify": "node --test scripts/netlify-gateway.test.mjs",
    "validate:netlify": "node scripts/validate-netlify.mjs",
    "build:railway": "node scripts/build-railway.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:ssr": "node dist/architecture-portfolio/server/server.mjs",
    "validate:ssr": "node scripts/validate-ssr.mjs",
    "validate:api-gateway": "node scripts/validate-api-gateway.mjs",
    "api:generate": "openapi-ts",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "test:auth:smoke": "node scripts/auth-smoke.mjs",
    "test:auth:browser": "node scripts/auth-browser-smoke.mjs",
    "test:media:browser": "node scripts/media-browser-smoke.mjs",
    "test:projects:browser": "node scripts/project-browser-smoke.mjs",
    "test:project-drafts:browser": "node scripts/project-drafts-browser-smoke.mjs",
    "test:project-uploads:browser": "node scripts/admin-project-upload-browser-smoke.mjs",
    "test:sections:browser": "node scripts/sections-browser-smoke.mjs",
    "test:models:browser": "node scripts/model-browser-smoke.mjs",
    "test:photo-picker:browser": "node scripts/photo-picker-browser-smoke.mjs",
    "test:content:browser": "node scripts/content-browser-smoke.mjs",
    "test:public:browser": "node scripts/public-browser-smoke.mjs",
    "test:public-projects:browser": "node scripts/public-projects-browser-smoke.mjs",
    "test:public-detail:browser": "node scripts/public-projects-browser-smoke.mjs --detail",
    "test:public-content:browser": "node scripts/public-content-browser-smoke.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.1",
    "@google/model-viewer": "4.4.0",
    "express": "^5.1.0",
    "meshoptimizer": "1.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@netlify/angular-runtime": "4.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "^4.3.2"
    }
  }
}
